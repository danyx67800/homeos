# HomeOS ships shell scripts and systemd units that run on Linux. A checkout on
# Windows must not rewrite them to CRLF: `#!/usr/bin/env bash\r` fails with
# "bad interpreter", and systemd rejects unit files with carriage returns.
* text=auto eol=lf

*.sh          text eol=lf
*.service     text eol=lf
*.rules       text eol=lf
*.caddy       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
install.sh    text eol=lf
scripts/*     text eol=lf
config/**     text eol=lf

*.png binary
*.jpg binary
*.ico binary

*.go          text eol=lf
*.mod         text eol=lf
Makefile      text eol=lf
